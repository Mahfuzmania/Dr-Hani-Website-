import { readFile, writeFile, mkdir } from 'node:fs/promises'
import path from 'node:path'
import sharp from 'sharp'
import { siteContentV2 } from '../shared/site-content-v2'
import { publicContent } from '../shared/public-content'
import { editorialGallery } from '../shared/editorial-gallery'
import { homepagePhotos } from '../shared/photo-curation'

await mkdir('docs/photographic-refinement', { recursive: true })
const content = publicContent(siteContentV2)
const dimensions: Record<string, { width: number; height: number }> = {}
for (const item of content.galleryItems) {
  const metadata = await sharp(
    path.join('frontend/public', item.image),
  ).metadata()
  dimensions[item.image] = { width: metadata.width!, height: metadata.height! }
}
await writeFile(
  'shared/photo-dimensions.ts',
  `// Intrinsic dimensions of the supplied local photographs; generated by prepare-photo-review.mts.\nexport const photoDimensions: Record<string, { width: number; height: number }> = ${JSON.stringify(dimensions, null, 2)}\n`,
)
const manifest = JSON.parse(
  await readFile('docs/media-manifest.json', 'utf8'),
) as { source: string; derivative: string }[]
const baseline = JSON.parse(
  await readFile('docs/photo-restoration/content-inventory.json', 'utf8'),
)
const newPhotos = editorialGallery.map((item) => ({
  id: item.id,
  original: manifest.find((entry) =>
    entry.derivative.endsWith(`${item.id}.webp`),
  )?.source,
  derivative: item.image,
  visibleSubject: item.altText,
  group: item.event,
  caption: item.caption,
  crop: { focalX: item.focalX, focalY: item.focalY, fullImageAvailable: true },
  placement: item.featuredOnHomepage
    ? `Homepage: ${item.homepageSection}; /gallery`
    : '/gallery',
  priorReviewState: baseline.newPublishedPhotographs.includes(item.id)
    ? 'published'
    : 'draft',
  reviewState: item.status,
}))
await writeFile(
  'docs/photographic-refinement/asset-sheet.json',
  JSON.stringify(newPhotos, null, 2) + '\n',
)
await writeFile(
  'docs/photographic-refinement/preservation.json',
  JSON.stringify(
    {
      rollbackCommit: '2c14e4b',
      originalBaseline: baseline.baseline,
      originalGallery: baseline.gallery.map((item: { id: string }) => ({
        id: item.id,
        retained: content.galleryItems.some((photo) => photo.id === item.id),
        location: '/gallery',
      })),
      videos: baseline.videos.map((item: { id: string }) => ({
        id: item.id,
        retained: content.mediaItems.some((video) => video.id === item.id),
        location: '/media-events#interviews',
      })),
      essays: content.publications
        .filter((entry) => entry.kind === 'essay')
        .map((entry) => ({
          id: entry.id,
          sources: entry.sources.map((source) => source.url),
          location: '/writing',
        })),
      reports: content.publications
        .filter((entry) => entry.kind === 'report')
        .map((entry) => ({ id: entry.id, location: '/media-events#press' })),
      career: content.profile.journeyTimeline.map((item) => ({
        ...item,
        location: '/about',
      })),
      photoCounts: {
        original: baseline.gallery.length,
        new: newPhotos.length,
        archive: content.galleryItems.length,
        newOnHomepage: newPhotos.filter((item) =>
          item.placement.startsWith('Homepage'),
        ).length,
      },
      sections: Object.fromEntries(
        ['medical-work', 'dialogues', 'public-work'].map((section) => [
          section,
          homepagePhotos(
            content.galleryItems,
            section as 'medical-work' | 'dialogues' | 'public-work',
          ).map((item) => item.id),
        ]),
      ),
      routes: [
        '/',
        '/about',
        '/writing',
        '/gallery',
        '/media-events',
        '/updates',
        '/contact',
        '/privacy',
        '/medical-service',
        '/public-service',
        '/leadership',
        ...content.updates.map((item) => `/updates/${item.slug}`),
      ],
    },
    null,
    2,
  ) + '\n',
)
console.log(
  `Prepared intrinsic dimensions and preservation evidence: ${newPhotos.length} new photographs, ${content.galleryItems.length} archive records.`,
)
