import path from 'node:path'
import { mkdir, writeFile } from 'node:fs/promises'
import { BasePayload, buildConfig } from 'payload'
import { postgresAdapter } from '@payloadcms/db-postgres'
import { lexicalEditor } from '@payloadcms/richtext-lexical'
import { collections } from '../backend/src/payload/collections'
import { globals } from '../backend/src/payload/globals'

process.env.PAYLOAD_DB_DRIVER = 'postgres'
// Payload sanitization mutates collection objects and adds cached flattened fields.
// Capture a separate baseline before resolving the application configuration.
function clone<T>(value: T): T {
  if (Array.isArray(value)) return value.map(clone) as T
  if (value && typeof value === 'object')
    return Object.fromEntries(Object.entries(value).map(([key, child]) => [key, clone(child)])) as T
  return value
}
const baselineCollections = clone(collections)
  .filter((collection) => collection.slug !== 'publications')
  .map((collection) => ({
    ...collection,
    fields:
      collection.slug === 'gallery-items'
        ? collection.fields.filter(
            (field) => !('name' in field) || !['externalId', 'event', 'relatedActivity'].includes(field.name),
          )
        : collection.fields,
  }))
const baselineConfig = await buildConfig({
  secret: 'offline-schema-generation',
  typescript: { autoGenerate: false },
  db: postgresAdapter({ pool: { connectionString: '' }, push: false }),
  editor: lexicalEditor(),
  globals: clone(globals),
  collections: baselineCollections,
})
const before = await new BasePayload().init({
  config: baselineConfig,
  disableDBConnect: true,
  disableOnInit: true,
})
const kit = before.db.requireDrizzleKit()
const baseline = await kit.generateDrizzleJson(before.db.schema)
const { default: configPromise } = await import('../backend/payload.config')
const config = await configPromise
const after = await new BasePayload().init({ config, disableDBConnect: true, disableOnInit: true })
// Both schemas are generated by the installed adapter; no database is connected or changed.
const updated = await kit.generateDrizzleJson(after.db.schema)
const up = await kit.generateMigration(baseline, updated)
const down = await kit.generateMigration(updated, baseline)
if (up.some((statement: string) => /DROP TABLE|DROP COLUMN|TRUNCATE/i.test(statement)))
  throw new Error('Refusing a destructive UP migration.')
const directory = path.resolve('backend/src/migrations')
await mkdir(directory, { recursive: true })
const filename = '20261020_000000_editorial_publications'
await writeFile(
  path.join(directory, `${filename}.ts`),
  `import { type MigrateUpArgs, type MigrateDownArgs, sql } from '@payloadcms/db-postgres'\n\nexport async function up({ db }: MigrateUpArgs): Promise<void> {\n  await db.execute(sql\`${up.join('\n')}\`)\n}\n\n// Rollback removes the new archive data. Export it before invoking down.\nexport async function down({ db }: MigrateDownArgs): Promise<void> {\n  await db.execute(sql\`${down.join('\n')}\`)\n}\n`,
)
await writeFile(path.join(directory, `${filename}.json`), JSON.stringify(updated, null, 2) + '\n')
await writeFile(
  path.join(directory, 'index.ts'),
  `import * as editorial from './${filename}'\nexport const migrations = [{ up: editorial.up, down: editorial.down, name: '${filename}' }]\n`,
)
console.log(`Generated additive migration: ${up.length} UP statements; no database connection.`)
process.exit(0)
